<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:M2Hub.Desktop.ViewModels"
             xmlns:views="using:M2Hub.Desktop.Views"
             x:Class="M2Hub.Desktop.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <DataTemplate DataType="vm:AccountsViewModel"><views:AccountsView /></DataTemplate>
    <DataTemplate DataType="vm:EventsViewModel"><views:EventsView /></DataTemplate>
    <DataTemplate DataType="vm:ItemshopViewModel"><views:ItemshopView /></DataTemplate>
    <DataTemplate DataType="vm:GuildCalcViewModel"><views:GuildCalcView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:ConfirmDialogViewModel"><views:ConfirmDialogView /></DataTemplate>
    <DataTemplate DataType="vm:UpdateDialogViewModel"><views:UpdateDialogView /></DataTemplate>
    <DataTemplate DataType="vm:AccountEditViewModel"><views:AccountEditView /></DataTemplate>
    <DataTemplate DataType="vm:CharacterEditViewModel"><views:CharacterEditView /></DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://M2Hub/Styles/Theme.axaml" />
  </Application.Styles>

</Application>
