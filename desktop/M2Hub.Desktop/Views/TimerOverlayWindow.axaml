<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:M2Hub.Desktop.ViewModels"
        xmlns:loc="using:M2Hub.Desktop.Services"
        x:Class="M2Hub.Desktop.Views.TimerOverlayWindow"
        x:DataType="vm:RunTimersViewModel"
        Title="M2Hub Timer"
        Topmost="True" ShowInTaskbar="False" CanResize="False"
        SystemDecorations="None" SizeToContent="WidthAndHeight"
        Background="{StaticResource HeaderBrush}">

  <!-- Das Fenster haengt ueber dem Spiel und wird im Spielen getroffen, nicht
       gelesen: grosse Flaechen, viel Abstand, keine Feinheiten. -->
  <!-- Keine runden Ecken und derselbe Grund wie das Fenster: Avalonia
       zeichnet hier auf eine Weiterleitungsflaeche (siehe Program.cs, noetig
       fuer die Fensteraufnahme in OBS), und die kann nicht durchsichtig sein.
       Runde Ecken haetten also schwarze Zwickel. -->
  <Border Background="{StaticResource HeaderBrush}"
          BorderBrush="{StaticResource SubtleBrush}" BorderThickness="1"
          Padding="8" Name="Frame">
    <StackPanel Spacing="6">
      <!-- Gezogen wird an der ganzen Karte; hier steht nur das Kreuz. -->
      <Grid ColumnDefinitions="*,Auto" Name="Handle">
        <TextBlock Grid.Column="0" Classes="muted" FontSize="10" Text="M2Hub"
                   VerticalAlignment="Center" Margin="4,0,0,0" />
        <Button Grid.Column="1" Classes="icon" Content="✕" FontSize="10"
                Name="HideButton" />
      </Grid>

      <ItemsControl ItemsSource="{Binding Timers}" Name="Tiles">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" MaxWidth="420" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:RunTimerViewModel">
            <Button Classes="timer" Classes.running="{Binding IsRunning}"
                    Margin="0,0,6,6"
                    Command="{Binding $parent[ItemsControl].DataContext.StartCommand}"
                    CommandParameter="{Binding}"
                    PointerPressed="TilePointerPressed">
              <StackPanel>
                <TextBlock Classes="muted" FontSize="10" HorizontalAlignment="Center"
                           Text="{Binding Label}" />
                <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                           Text="{Binding Text}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <!-- Schnelleingabe: je Lauf die Truhenzahlen, die er ueblicherweise
           abwirft. Ein Klick traegt den Lauf fuer heute ein - keine
           Tastatur, im Spiel hat man die Hand an der Maus. -->
      <StackPanel Spacing="4" IsVisible="{Binding HasChestRows}">
        <TextBlock Classes="muted" FontSize="10" Margin="4,2,0,0"
                   Text="{loc:T timers.chests}" />

        <ItemsControl ItemsSource="{Binding ChestRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ChestRow">
              <StackPanel Spacing="2" Margin="0,0,0,4">
                <TextBlock Classes="muted" FontSize="10" Margin="4,0,0,0"
                           Text="{Binding Run}" />
                <ItemsControl ItemsSource="{Binding Buttons}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" MaxWidth="420" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ChestButton">
                      <Button Classes="chip" Margin="0,0,5,0" MinWidth="34"
                              Content="{Binding Label}"
                              Command="{Binding $parent[Window].DataContext.EnterCommand}"
                              CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
