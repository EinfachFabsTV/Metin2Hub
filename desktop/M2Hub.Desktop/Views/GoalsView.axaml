<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:M2Hub.Desktop.ViewModels"
             xmlns:loc="using:M2Hub.Desktop.Services"
             x:Class="M2Hub.Desktop.Views.GoalsView"
             x:DataType="vm:GoalsViewModel">

  <UserControl.Resources>
    <loc:ProgressArcConverter x:Key="arc" />
    <loc:ProgressColorConverter x:Key="ringColor" />
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Margin="18" Spacing="14">

      <StackPanel Spacing="2">
        <TextBlock Classes="h1" Text="{loc:T goals.title}" />
        <TextBlock Classes="muted" Text="{loc:T goals.subtitle}" TextWrapping="Wrap" />
      </StackPanel>

      <Grid ColumnDefinitions="1.3*,0.9*" ColumnSpacing="14">

        <!-- ===== Das aktive Ziel ===== -->
        <StackPanel Grid.Column="0" Spacing="14">

          <!-- Kein aktives Ziel -->
          <Border Classes="card" Padding="18" IsVisible="{Binding !HasActive}">
            <TextBlock Classes="muted" Text="{loc:T goals.none}" TextWrapping="Wrap" />
          </Border>

          <!-- Hero: Prozent-Ring + Kennzahlen -->
          <Border Classes="card" Padding="22" IsVisible="{Binding HasActive}">
            <StackPanel Spacing="18">

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">

                <!-- Links: Titel, Zielbetrag, Kennzahl-Kacheln -->
                <StackPanel Grid.Column="0" Spacing="14" VerticalAlignment="Center">

                  <StackPanel Spacing="4">
                    <Border Classes="chip active" Padding="8,3" HorizontalAlignment="Left">
                      <TextBlock FontSize="11" Text="{loc:T goals.hero.active}" />
                    </Border>
                    <TextBlock Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" />
                  </StackPanel>

                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" Classes="panel" Padding="10,8">
                      <StackPanel Spacing="2">
                        <TextBlock Classes="muted" FontSize="10" Text="{loc:T goals.hero.target}" />
                        <TextBlock FontWeight="Bold" FontSize="14"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Text="{Binding TargetLabel}" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="panel" Padding="10,8">
                      <StackPanel Spacing="2">
                        <TextBlock Classes="muted" FontSize="10" Text="{loc:T goals.rest}" />
                        <TextBlock FontWeight="Bold" FontSize="14" Text="{Binding RestLabel}" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="panel" Padding="10,8">
                      <StackPanel Spacing="2">
                        <TextBlock Classes="muted" FontSize="10" Text="{loc:T goals.hero.forecast}" />
                        <TextBlock FontWeight="Bold" FontSize="12"
                                   Text="{Binding RunsLeftLabel}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </StackPanel>

                <!-- Rechts: der Prozent-Ring, nach Fortschritt gefaerbt -->
                <Grid Grid.Column="1" Width="168" Height="168" VerticalAlignment="Center">
                  <Viewbox>
                    <Canvas Width="100" Height="100">
                      <Ellipse Width="84" Height="84" Canvas.Left="8" Canvas.Top="8"
                               Stroke="{StaticResource SubtleBrush}" StrokeThickness="7"
                               Fill="Transparent" />
                      <Path Stroke="{Binding Progress, Converter={StaticResource ringColor}}"
                            StrokeThickness="7" StrokeLineCap="Round"
                            Data="{Binding Progress, Converter={StaticResource arc}}" />
                    </Canvas>
                  </Viewbox>
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1">
                    <TextBlock HorizontalAlignment="Center" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Text="{Binding ProgressLabel}" />
                    <TextBlock HorizontalAlignment="Center" Classes="muted" FontSize="10"
                               Text="{loc:T goals.hero.onhand}" />
                    <TextBlock HorizontalAlignment="Center" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource SuccessBrush}"
                               Text="{Binding NetLabel}" />
                  </StackPanel>
                </Grid>
              </Grid>

              <Button Classes="chip" HorizontalAlignment="Left"
                      Content="{loc:T goals.finish}"
                      IsEnabled="{Binding CanFinish}"
                      Command="{Binding FinishCommand}" />
            </StackPanel>
          </Border>

          <!-- ===== Die Rechnung dahinter ===== -->
          <Border Classes="card" Padding="18" IsVisible="{Binding HasActive}">
            <StackPanel Spacing="10">
              <TextBlock Classes="h2" Text="{loc:T goals.breakdown}" />

              <StackPanel Spacing="7">
                <Border Classes="statrow">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="muted" Text="{loc:T goals.profit}" />
                    <TextBlock Grid.Column="1" FontWeight="Bold" Text="{Binding ProfitLabel}" />
                  </Grid>
                </Border>
                <Border Classes="statrow" IsVisible="{Binding HasCarry}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="muted" Text="{loc:T goals.carry}" />
                    <TextBlock Grid.Column="1" FontWeight="Bold" Text="{Binding CarryLabel}" />
                  </Grid>
                </Border>
                <Border Classes="statrow">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="muted" Text="{loc:T goals.income}" />
                    <TextBlock Grid.Column="1" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}"
                               Text="{Binding IncomeLabel}" />
                  </Grid>
                </Border>
                <Border Classes="statrow" IsVisible="{Binding HasPaid}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="muted" Text="{loc:T goals.paid}" />
                    <TextBlock Grid.Column="1" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}"
                               Text="{Binding PaidProgressLabel}" />
                  </Grid>
                </Border>
                <Border Classes="statrow">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="muted" Text="{loc:T goals.expenses}" />
                    <TextBlock Grid.Column="1" FontWeight="Bold"
                               Foreground="{StaticResource AmberBrush}"
                               Text="{Binding ExpensesLabel}" />
                  </Grid>
                </Border>
                <Border Classes="statrow" IsVisible="{Binding HasAdjust}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="muted" Text="{loc:T goals.adjust}" />
                    <TextBlock Grid.Column="1" FontWeight="Bold" Text="{Binding AdjustLabel}" />
                  </Grid>
                </Border>
              </StackPanel>

              <!-- Won-Abgleich mit dem Spiel -->
              <Border Classes="statrow">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding SetCurrentWonText, Mode=TwoWay}"
                             Watermark="{loc:T goals.currentwon.label}" KeyDown="SetWonKeyDown" />
                    <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center"
                               TextWrapping="Wrap" Text="{loc:T goals.adjust.hint}" />
                    <Button Grid.Column="2" Classes="primary" Content="{loc:T goals.adjust.set}"
                            Command="{Binding SetCurrentWonCommand}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- ===== Ausgaben, Einnahmen, Abgleich ===== -->
          <Border Classes="card" Padding="18" IsVisible="{Binding HasActive}">
            <StackPanel Spacing="10">
              <TextBlock Classes="h2" Text="{loc:T goals.booking}" />

              <ItemsControl ItemsSource="{Binding Kinds}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:RunChip">
                    <Button Classes="chip" Classes.active="{Binding IsActive}"
                            Margin="0,0,6,6" Content="{Binding Label}"
                            Command="{Binding $parent[UserControl].DataContext.ChooseKindCommand}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding Amount, Mode=TwoWay}"
                         Watermark="{loc:T goals.booking.amount}" KeyDown="AddKeyDown" />
                <TextBox Grid.Column="1" Text="{Binding Note, Mode=TwoWay}"
                         Watermark="{loc:T goals.booking.note}" KeyDown="AddKeyDown" />
                <Button Grid.Column="2" Classes="primary" Content="{loc:T goals.booking.add}"
                        Command="{Binding AddBookingCommand}" />
              </Grid>

              <TextBlock Classes="muted" Text="{loc:T goals.booking.none}"
                         IsVisible="{Binding !HasBookings}" />

              <ItemsControl ItemsSource="{Binding Bookings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:GoalBookingViewModel">
                    <Border Classes="panel" Padding="10,7" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="9">
                        <TextBlock Grid.Column="0" FontSize="11" Classes="muted"
                                   VerticalAlignment="Center" Text="{Binding DayLabel}" />
                        <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold"
                                   VerticalAlignment="Center" Text="{Binding AmountLabel}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock FontSize="12" IsVisible="{Binding HasNote}"
                                     TextTrimming="CharacterEllipsis" Text="{Binding Note}" />
                          <TextBlock Classes="muted" FontSize="11"
                                     TextTrimming="CharacterEllipsis" Text="{Binding KindLabel}" />
                        </StackPanel>
                        <Button Grid.Column="3" Classes="icon" Content="✎"
                                IsVisible="{Binding CanEdit}"
                                ToolTip.Tip="{loc:T goals.booking.edit}"
                                Command="{Binding $parent[UserControl].DataContext.EditBookingCommand}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="4" Classes="icon danger" Content="✕"
                                ToolTip.Tip="{loc:T goals.booking.delete}"
                                Command="{Binding $parent[UserControl].DataContext.DeleteBookingCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ===== Warteschlange ===== -->
        <StackPanel Grid.Column="1" Spacing="14">

          <Border Classes="card" Padding="18">
            <StackPanel Spacing="10">
              <TextBlock Classes="h2" Text="{loc:T goals.new}" />
              <TextBox Text="{Binding NewTitle, Mode=TwoWay}"
                       Watermark="{loc:T goals.new.title}" KeyDown="AddGoalKeyDown" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding NewTarget, Mode=TwoWay}"
                         Watermark="{loc:T goals.new.target}" KeyDown="AddGoalKeyDown" />
                <Button Grid.Column="1" Classes="primary" Content="{loc:T goals.new.add}"
                        Command="{Binding AddGoalCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="18">
            <StackPanel Spacing="10">
              <TextBlock Classes="h2" Text="{loc:T goals.queue}" />

              <ItemsControl ItemsSource="{Binding Queue}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:GoalRowViewModel">
                    <Border Classes="panel" Padding="10,7" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="5">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                          <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Title}"
                                     TextTrimming="CharacterEllipsis" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="muted" FontSize="11" Text="{Binding TargetLabel}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource PrimaryBrush}"
                                       Text="{loc:T goals.queue.active}"
                                       IsVisible="{Binding IsActive}" />
                          </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon" Content="↑"
                                Command="{Binding $parent[UserControl].DataContext.MoveUpCommand}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="2" Classes="icon" Content="↓"
                                Command="{Binding $parent[UserControl].DataContext.MoveDownCommand}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="3" Classes="icon danger" Content="✕"
                                ToolTip.Tip="{loc:T goals.delete}"
                                Command="{Binding $parent[UserControl].DataContext.DeleteGoalCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Spacing="6">
                <TextBlock Classes="muted" Text="{loc:T goals.mode}" />
                <ItemsControl ItemsSource="{Binding Modes}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:RunChip">
                      <Button Classes="chip" Classes.active="{Binding IsActive}"
                              Margin="0,0,6,6" Content="{Binding Label}"
                              Command="{Binding $parent[UserControl].DataContext.ChooseModeCommand}"
                              CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- ===== Erledigt ===== -->
          <Border Classes="card" Padding="18" IsVisible="{Binding HasDone}">
            <StackPanel Spacing="10">
              <TextBlock Classes="h2" Text="{loc:T goals.done}" />

              <ItemsControl ItemsSource="{Binding DoneGoals}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:GoalRowViewModel">
                    <Border Classes="panel" Padding="10,7" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                          <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Title}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="muted" FontSize="11" Text="{Binding TargetLabel}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource SuccessBrush}"
                                   Text="{loc:T goals.queue.done}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
