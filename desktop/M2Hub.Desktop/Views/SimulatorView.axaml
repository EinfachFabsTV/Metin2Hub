<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:M2Hub.Desktop.ViewModels"
             xmlns:loc="using:M2Hub.Desktop.Services"
             x:Class="M2Hub.Desktop.Views.SimulatorView"
             x:DataType="vm:SimulatorViewModel">

  <ScrollViewer>
    <Grid Margin="18" ColumnDefinitions="0.9*,1.1*" ColumnSpacing="14">

      <!-- ===== Auswahl ===== -->
      <Border Grid.Column="0" Classes="card" Padding="18" VerticalAlignment="Top">
        <StackPanel Spacing="14">
          <StackPanel Spacing="2">
            <TextBlock Classes="h1" Text="{loc:T costumes.sim.title}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:T costumes.sim.subtitle}" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding SlotPickers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:SimSlot">
                <StackPanel Spacing="4" Margin="0,0,0,10">
                  <TextBlock Classes="muted" Text="{Binding Title}" />
                  <ComboBox HorizontalAlignment="Stretch" MaxDropDownHeight="360"
                            ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:SimOption">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Image Width="24" Height="24" Source="{Binding Icon}" IsVisible="{Binding HasIcon}" />
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="{loc:T costumes.sim.best}" Command="{Binding BestCommand}" />
            <Button Classes="nav" Content="{loc:T costumes.sim.reset}" Command="{Binding ResetCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ===== Ergebnis ===== -->
      <Border Grid.Column="1" Classes="card" Padding="18" VerticalAlignment="Top"
              BorderBrush="{StaticResource PrimaryBrush}">
        <StackPanel Spacing="14">
          <Border Classes="panel" Padding="16">
            <StackPanel HorizontalAlignment="Center" Spacing="2">
              <TextBlock Classes="statvalue" Foreground="{StaticResource SuccessBrush}"
                         HorizontalAlignment="Center" Text="{Binding TotalLabel}" />
              <TextBlock Classes="muted" FontSize="11" HorizontalAlignment="Center"
                         Text="{loc:T costumes.sim.totalExp}" />
            </StackPanel>
          </Border>

          <StackPanel Spacing="6" IsVisible="{Binding HasSets}">
            <TextBlock FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}"
                       Text="{loc:T costumes.sim.setBonuses}" />
            <ItemsControl ItemsSource="{Binding SetBonuses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:BonusRow">
                  <Border Classes="statrow" Margin="0,0,0,4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" FontSize="12" Text="{Binding Label}" />
                      <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold"
                                 Foreground="{StaticResource SuccessBrush}" Text="{Binding Value}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="6" IsVisible="{Binding HasOwn}">
            <TextBlock FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}"
                       Text="{loc:T costumes.sim.ownExp}" />
            <ItemsControl ItemsSource="{Binding OwnBonuses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:BonusRow">
                  <Border Classes="statrow" Margin="0,0,0,4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" FontSize="12" Text="{Binding Label}" />
                      <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold"
                                 Foreground="{StaticResource SuccessBrush}" Text="{Binding Value}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{loc:T costumes.sim.note}" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
