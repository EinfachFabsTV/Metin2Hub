<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:M2Hub.Desktop.ViewModels"
             xmlns:loc="using:M2Hub.Desktop.Services"
             x:Class="M2Hub.Desktop.Views.LootFilterEditorView"
             x:DataType="vm:LootFilterEditorViewModel">

  <UserControl.Styles>
    <Style Selector="ToggleButton.onoff">
      <Setter Property="MinWidth" Value="56" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="ToggleButton.onoff:checked">
      <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
      <Setter Property="Foreground" Value="#04210f" />
    </Style>
    <Style Selector="NumericUpDown.range">
      <Setter Property="Width" Value="96" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Increment" Value="1" />
      <Setter Property="FormatString" Value="0" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="18" Spacing="12">

      <StackPanel Spacing="2">
        <TextBlock Classes="h1" Text="{loc:T lootfilter.editorTitle}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:T lootfilter.editorSubtitle}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Classes="danger" Content="{loc:T lootfilter.reset}" Command="{Binding ResetCommand}" />
        <TextBlock Classes="muted" VerticalAlignment="Center" FontSize="12.5"
                   Text="{loc:T lootfilter.phase2}" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Blocks}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:LootBlockViewModel">
            <Border Classes="card" Margin="0,0,0,10">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="15"
                             VerticalAlignment="Center" Text="{Binding Name}" />
                  <ToggleButton Grid.Column="1" Classes="onoff" IsChecked="{Binding On}"
                                Content="{Binding OnLabel}" />
                </Grid>

                <StackPanel Spacing="12" IsEnabled="{Binding On}">
                  <!-- Klasse -->
                  <StackPanel Spacing="6" IsVisible="{Binding ShowClasses}">
                    <TextBlock Classes="muted" FontSize="12" Text="{loc:T lootfilter.class}" />
                    <ItemsControl ItemsSource="{Binding Classes}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ToggleItem">
                          <CheckBox Margin="0,0,16,0" IsChecked="{Binding Checked}" Content="{Binding Name}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- Art / Unterkategorien -->
                  <StackPanel Spacing="6" IsVisible="{Binding ShowSubs}">
                    <TextBlock Classes="muted" FontSize="12" Text="{loc:T lootfilter.kind}" />
                    <ItemsControl ItemsSource="{Binding Subs}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ToggleItem">
                          <CheckBox Margin="0,0,16,0" IsChecked="{Binding Checked}" Content="{Binding Name}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- Veredelung / Level -->
                  <StackPanel Spacing="8" IsVisible="{Binding ShowRanges}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="muted" Width="130" VerticalAlignment="Center"
                                 Text="{loc:T lootfilter.refine}" />
                      <NumericUpDown Classes="range" Maximum="200" Value="{Binding RefineMin}" />
                      <TextBlock VerticalAlignment="Center" Text="~" />
                      <NumericUpDown Classes="range" Maximum="200" Value="{Binding RefineMax}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="muted" Width="130" VerticalAlignment="Center"
                                 Text="{loc:T lootfilter.level}" />
                      <NumericUpDown Classes="range" Maximum="120" Value="{Binding LevelMin}" />
                      <TextBlock VerticalAlignment="Center" Text="~" />
                      <NumericUpDown Classes="range" Maximum="120" Value="{Binding LevelMax}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="card" IsVisible="{Binding IsEmpty}">
        <TextBlock Classes="muted" HorizontalAlignment="Center" Text="{loc:T lootfilter.editorEmpty}" />
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
