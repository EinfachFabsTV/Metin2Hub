<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:M2Hub.Desktop.ViewModels"
             xmlns:loc="using:M2Hub.Desktop.Services"
             x:Class="M2Hub.Desktop.Views.UpdateDialogView"
             x:DataType="vm:UpdateDialogViewModel">

  <StackPanel Spacing="14">
    <TextBlock Classes="h2" Text="{Binding Title}" />
    <TextBlock Classes="muted" Text="{Binding Current}" />

    <TextBlock Text="{Binding Notes}" IsVisible="{Binding HasNotes}" TextWrapping="Wrap" />

    <TextBlock Classes="muted" Text="{Binding SizeHint}" IsVisible="{Binding CanInstall}" />

    <StackPanel Spacing="6" IsVisible="{Binding Busy}">
      <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6" />
      <TextBlock Classes="muted" Text="{Binding Status}" />
    </StackPanel>

    <TextBlock Classes="muted" IsVisible="{Binding CannotInstall}" TextWrapping="Wrap"
               Text="{loc:T update.noInstall}" />

    <TextBlock Classes="danger" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{loc:T common.later}" Command="{Binding LaterCommand}" IsEnabled="{Binding NotBusy}" />
      <Button Content="{loc:T update.page}" Command="{Binding OpenPageCommand}" IsEnabled="{Binding NotBusy}" />
      <Button Classes="primary" Content="{loc:T update.install}" Command="{Binding InstallCommand}"
              IsVisible="{Binding CanInstall}" IsEnabled="{Binding NotBusy}" />
    </StackPanel>
  </StackPanel>
</UserControl>
