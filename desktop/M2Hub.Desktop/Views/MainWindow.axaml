<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:M2Hub.Desktop.ViewModels"
        xmlns:loc="using:M2Hub.Desktop.Services"
        x:Class="M2Hub.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1400" Height="860" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="avares://M2Hub/Assets/m2hub.ico"
        Title="M2Hub"
        Background="{StaticResource DeepBrush}"
        TransparencyLevelHint="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

  <!-- Im Vollbild ragt der Rahmen sonst ueber den sichtbaren Bereich hinaus -->
  <Panel Margin="{Binding $parent[Window].OffScreenMargin}">
    <!-- Hintergrund-Glow wie auf der Website -->
    <Border Background="{StaticResource GlowBrush}" />

    <DockPanel>
      <!-- Kopfzeile -->
      <Border Name="TitleBar" DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}"
              BorderBrush="{StaticResource SubtleBrush}" BorderThickness="0,0,0,1" Padding="18,12">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">

          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Image Source="avares://M2Hub/Assets/m2hub.png" Width="34" Height="34" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="M2Hub" FontWeight="Bold" FontSize="16" />
              <TextBlock Classes="muted" Text="{Binding LastRefreshLabel}" />
            </StackPanel>
          </StackPanel>

          <!-- Was gerade laeuft: globale Events und Happy Hours -->
          <ItemsControl Grid.Column="1" ItemsSource="{Binding ActiveNow}"
                        IsVisible="{Binding HasActiveNow}"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ActiveBadgeViewModel">
                <Button Classes="live" Classes.happy="{Binding IsHappyHour}"
                        Command="{Binding OpenCommand}" Margin="0,1,5,1"
                        ToolTip.Tip="{Binding Title}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Image Source="{Binding Icon}" Width="13" Height="13"
                           IsVisible="{Binding HasIcon}" VerticalAlignment="Center" />
                    <Ellipse Classes="dot" Classes.happy="{Binding IsHappyHour}"
                             Width="6" Height="6" VerticalAlignment="Center"
                             IsVisible="{Binding !HasIcon}" />
                    <!-- Eine Zeile, notfalls gekuerzt - der ganze Text steht im
                         Tooltip und auf der Events-Seite. -->
                    <TextBlock Text="{Binding Title}" FontSize="11" MaxWidth="200"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Remaining}" FontSize="10" Opacity="0.7"
                               TextWrapping="NoWrap" IsVisible="{Binding HasRemaining}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Nachschlagewerk und Handelsglas bleiben in der Kopfzeile: sie
               fuehren aus der App heraus und gehoeren nicht zu den Bereichen. -->
          <!-- Hier standen Verweise auf eine Markt- und Wiki-Seite. Die Seite
               schliesst, und ein toter Link ist schlechter als keiner. -->

          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Classes="danger" VerticalAlignment="Center" FontSize="12"
                       Text="{Binding RefreshError}" IsVisible="{Binding HasRefreshError}"
                       MaxWidth="320" TextTrimming="CharacterEllipsis" />
            <Button Content="{loc:T header.refresh}" Classes="primary" Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding NotBusy}"
                    ToolTip.Tip="{loc:T header.refresh.tip}" />

            <!-- Fensterknoepfe im Stil des Programms statt der Windows-Leiste -->
            <StackPanel Orientation="Horizontal" Spacing="2" Margin="10,0,0,0">
              <Button Name="MinimizeButton" Classes="caption" Content="─" ToolTip.Tip="{loc:T window.minimize}" />
              <Button Name="MaximizeButton" Classes="caption" Content="▢" ToolTip.Tip="{loc:T window.maximize}" />
              <Button Name="CloseButton" Classes="caption close" Content="✕" ToolTip.Tip="{loc:T window.close}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Bereiche links. Liegt die Tastatur auf der Leiste, springt
           Hoch/Runter zum Nachbarn. -->
      <Border DockPanel.Dock="Left" Name="NavBar" Background="{StaticResource HeaderBrush}"
              BorderBrush="{StaticResource SubtleBrush}" BorderThickness="0,0,1,0"
              Padding="8,12" Width="152">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Classes="side" Classes.active="{Binding IsSettings}"
                  Command="{Binding ShowSettingsCommand}" Content="{loc:T nav.settings}" />

          <!-- Die Abklingzeiten ueber dem Spiel: ein Griff waehrend des
               Spielens, deshalb hier und nicht in den Einstellungen. -->
          <Button DockPanel.Dock="Bottom" Classes="side" Margin="0,0,0,6"
                  IsVisible="{Binding HasTimers}"
                  ToolTip.Tip="{loc:T settings.timers.hint}"
                  Command="{Binding ToggleTimersCommand}"
                  Content="{loc:T nav.timers}" />

          <!-- Waehrend eines Streams gebraucht, nicht in den Einstellungen
               gesucht: setzt „seit Stream-Start" auf jetzt. Steht nur da,
               wenn eine Einblendung laeuft. -->
          <Button DockPanel.Dock="Bottom" Classes="side" Margin="0,0,0,6"
                  IsVisible="{Binding HasStreamOverlay}"
                  ToolTip.Tip="{loc:T settings.stream.reset}"
                  Command="{Binding ResetStreamStartCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Text="●" Foreground="{StaticResource DangerBrush}" FontSize="11"
                         VerticalAlignment="Center" />
              <TextBlock Text="{loc:T nav.streamStart}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel Spacing="2">
            <Button Classes="side" Classes.active="{Binding IsStart}"
                    Command="{Binding ShowStartCommand}" Content="{loc:T nav.start}" />
            <Button Classes="side" Classes.active="{Binding IsAccounts}"
                    Command="{Binding ShowAccountsCommand}" Content="{loc:T nav.accounts}" />
            <Button Classes="side" Classes.active="{Binding IsRuns}"
                    Command="{Binding ShowRunsCommand}" Content="{loc:T nav.runs}" />
            <Button Classes="side" Classes.active="{Binding IsGoals}"
                    Command="{Binding ShowGoalsCommand}" Content="{loc:T nav.goals}" />
            <Button Classes="side" Classes.active="{Binding IsEvents}"
                    Command="{Binding ShowEventsCommand}" Content="{loc:T nav.events}" />
            <Button Classes="side" Classes.active="{Binding IsItemshop}"
                    Command="{Binding ShowItemshopCommand}" Content="{loc:T nav.itemshop}" />
            <Button Classes="side" Classes.active="{Binding IsCostumes}"
                    Command="{Binding ShowCostumesCommand}" Content="{loc:T nav.costumes}" />
            <Button Classes="side" Classes.active="{Binding IsCalc}"
                    Command="{Binding ShowCalcCommand}" Content="{loc:T nav.calc}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Inhalt -->
      <ContentControl Content="{Binding CurrentPage}" Margin="0" />
    </DockPanel>

    <!-- Masken liegen ueber der Ansicht - kein zweites Fenster, keine
         Fensterrahmen des Betriebssystems. -->
    <Border Background="#D9020509" IsVisible="{Binding Dialogs.HasDialog}">
      <Border Classes="dialog" Width="470" Padding="22" Margin="20"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <ContentControl Content="{Binding Dialogs.Current}" />
      </Border>
    </Border>
  </Panel>
</Window>
