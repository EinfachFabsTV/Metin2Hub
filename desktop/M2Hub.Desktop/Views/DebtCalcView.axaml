<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:M2Hub.Desktop.ViewModels"
             xmlns:loc="using:M2Hub.Desktop.Services"
             x:Class="M2Hub.Desktop.Views.DebtCalcView"
             x:DataType="vm:DebtCalcViewModel">

  <ScrollViewer>
    <!-- Aufbau wie beim Gilden-Rechner: Eingaben schmal links, Ergebnis
         breit rechts. -->
    <Grid Margin="18" ColumnDefinitions="0.8*,1.2*" ColumnSpacing="14">

      <!-- ===== Eingaben ===== -->
      <Border Grid.Column="0" Classes="card" Padding="18" VerticalAlignment="Top">
        <StackPanel Spacing="16">

          <StackPanel Spacing="2">
            <TextBlock Classes="h1" Text="{loc:T calc.debt.title}" />
            <TextBlock Classes="muted" Text="{loc:T calc.debt.subtitle}" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Schuld und Abbezahltes: beides von Hand, beides in Won -->
          <StackPanel Spacing="4">
            <TextBlock Classes="muted" Text="{loc:T calc.debt.debt}" />
            <TextBox Text="{Binding DebtText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     KeyDown="CommitKeyDown" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="muted" Text="{loc:T calc.debt.farmed}" />
            <TextBox Text="{Binding FarmedText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     KeyDown="CommitKeyDown" />
          </StackPanel>

          <!-- Welcher Lauf -->
          <StackPanel Spacing="6">
            <TextBlock Classes="muted" Text="{loc:T calc.debt.run}" />
            <ItemsControl ItemsSource="{Binding Runs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:RunChip">
                  <Button Classes="chip" Classes.active="{Binding IsActive}"
                          Margin="0,0,6,6" Content="{Binding Label}"
                          Command="{Binding $parent[UserControl].DataContext.ChooseRunCommand}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Woher die Truhen je Lauf kommen -->
          <StackPanel Spacing="6">
            <TextBlock Classes="muted" Text="{loc:T calc.debt.chests}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="chip" Classes.active="{Binding UseStatsChests}"
                      Content="{loc:T calc.debt.chests.stats}"
                      Command="{Binding UseStatsChestsCommand}" />
              <Button Classes="chip" Classes.active="{Binding UseManualChests}"
                      Content="{loc:T calc.debt.chests.manual}"
                      Command="{Binding UseManualChestsCommand}" />
            </StackPanel>

            <TextBox Text="{Binding ManualChestsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     IsVisible="{Binding UseManualChests}"
                     KeyDown="CommitKeyDown" />

            <!-- Ohne Eintraege gibt es keinen Erfahrungswert - dann hilft nur
                 die Zahl von Hand. -->
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding NeedsManualChests}"
                       Text="{Binding NoEntriesHint}" />
          </StackPanel>

          <!-- Woher der Preis kommt -->
          <StackPanel Spacing="6">
            <TextBlock Classes="muted" Text="{loc:T calc.debt.price}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="chip" Classes.active="{Binding UsePriceRange}"
                      Content="{loc:T calc.debt.price.range}"
                      Command="{Binding UseRangeCommand}" />
              <Button Classes="chip" Classes.active="{Binding UseAveragePrice}"
                      Content="{loc:T calc.debt.price.average}"
                      IsEnabled="{Binding CanUseAveragePrice}"
                      Command="{Binding UseAverageCommand}" />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="7"
                  IsVisible="{Binding UsePriceRange}">
              <TextBox Grid.Column="0"
                       Text="{Binding PriceLowText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     KeyDown="CommitKeyDown" />
              <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" Text="–" />
              <TextBox Grid.Column="2"
                       Text="{Binding PriceHighText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     KeyDown="CommitKeyDown" />
            </Grid>

            <Border Classes="statrow" IsVisible="{Binding UseAveragePrice}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="muted"
                           Text="{loc:T calc.debt.price.fromStats}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" FontWeight="Bold" VerticalAlignment="Center"
                           Text="{Binding AveragePriceLabel}" />
              </Grid>
            </Border>
          </StackPanel>

          <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:T calc.debt.note}" />
        </StackPanel>
      </Border>

      <!-- ===== Ergebnis ===== -->
      <Border Grid.Column="1" Classes="card" Padding="18" VerticalAlignment="Top">
        <StackPanel Spacing="14">

          <TextBlock Classes="h2" Text="{loc:T calc.debt.result}" />

          <!-- Fortschritt: was von der Schuld schon abbezahlt ist -->
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="muted" Text="{loc:T calc.debt.progress}" />
              <TextBlock Grid.Column="1" FontWeight="Bold"
                         Foreground="{StaticResource SuccessBrush}"
                         Text="{Binding ProgressLabel}" />
            </Grid>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="8" />
          </StackPanel>

          <StackPanel Spacing="10">

            <StackPanel Spacing="2">
              <TextBlock Classes="muted" Text="{loc:T calc.debt.runsNeeded}" />
              <TextBlock FontSize="26" FontWeight="Bold"
                         Foreground="{StaticResource PrimaryBrush}"
                         Text="{Binding RunsLabel}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="statrow">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="muted" Text="{loc:T calc.debt.rest}" />
                <TextBlock Grid.Column="1" FontWeight="Bold" Text="{Binding RestLabel}" />
              </Grid>
            </Border>

            <Border Classes="statrow">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="muted" Text="{loc:T calc.debt.chestsPerRun}" />
                <TextBlock Grid.Column="1" FontWeight="Bold" Text="{Binding ChestsPerRunLabel}" />
              </Grid>
            </Border>

            <Border Classes="statrow">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="muted" Text="{loc:T calc.debt.perRun}" />
                <TextBlock Grid.Column="1" FontWeight="Bold" Text="{Binding PerRunLabel}" />
              </Grid>
            </Border>

            <Border Classes="statrow">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="muted" Text="{loc:T calc.debt.duration}"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" FontWeight="Bold" Text="{Binding DurationLabel}" />
              </Grid>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
